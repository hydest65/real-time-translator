# Copy this file to .env only if you want to test Azure Cloud.
# Local engines such as Argos do not need Azure credentials.

AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_region
AZURE_PHRASE_LIST=Teams,Codex,faster-whisper,MarianMT,Azure Speech
POST_MEETING_ASR_ENGINE=azure-batch
# Optional. Use only if your Speech resource requires a custom endpoint instead of region endpoint.
AZURE_FAST_TRANSCRIPTION_ENDPOINT=
AZURE_FAST_TRANSCRIPTION_API_VERSION=2024-11-15
# Required for POST_MEETING_ASR_ENGINE=azure-batch.
# Create a private Azure Blob container SAS URL with write/read/list permission.
AZURE_BATCH_CONTAINER_SAS_URL=
AZURE_BATCH_TRANSCRIPTION_ENDPOINT=
AZURE_BATCH_TRANSCRIPTION_API_VERSION=v3.2
ASR_PROMPT_TERMS=AHU,BMS,EMS,HVAC,WFI,CIP,SIP,P&ID
TERMINOLOGY_GLOSSARY_PATH=backend/glossary.csv

# Optional: Azure Monitor usage sync for account-level translated audio seconds.
# Create an app registration/service principal and grant it Monitoring Reader on the Speech resource.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SPEECH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<speech-resource-name>
# Optional display-only monthly budget/allowance in seconds.
AZURE_SPEECH_MONTHLY_SECONDS_LIMIT=

# Optional: local meeting-notes refinement model.
# Recommended local Ollama model for bilingual notes after cloud/local transcription.
POST_MEETING_LLM_ENABLED=1
POST_MEETING_LLM_PROVIDER=ollama
POST_MEETING_LLM_FALLBACK=1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NOTES_MODEL=qwen3:14b

# Optional: Aliyun Tingwu cloud meeting notes.
# Tingwu requires a public audio URL. You can use Aliyun OSS or a self-hosted relay such as Tencent Cloud.
ALIYUN_TINGWU_ENABLED=0
ALIBABA_CLOUD_ACCESS_KEY_ID=your_ram_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_ram_access_key_secret
ALIYUN_TINGWU_REGION=cn-beijing
ALIYUN_TINGWU_ENDPOINT=tingwu.cn-beijing.aliyuncs.com
ALIYUN_TINGWU_APP_KEY=your_tingwu_app_key
ALIYUN_TINGWU_UPLOAD_PROVIDER=oss
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_BUCKET=your_oss_bucket
ALIYUN_OSS_OBJECT_PREFIX=subtitle-studio/recordings/
ALIYUN_OSS_DELETE_AFTER_TINGWU=1
TENCENT_RELAY_BASE_URL=http://your-relay-host:8787
TENCENT_RELAY_DELETE_AFTER_TINGWU=1
